    // 26 ~ 30 磅：重型武器（轻机枪、狙击枪等）
    { "Priority": 46, "Value": 7, "Conditions": { "MinWeight": 26, "MaxWeight": 30 } },

    // 31 ~ 35 磅：超重型武器（通用机枪等）
