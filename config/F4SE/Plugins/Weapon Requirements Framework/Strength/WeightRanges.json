    // 11 ~ 15 磅：中轻武器（卡宾枪、短步枪等）
    { "Priority": 49, "Value": 4, "Conditions": { "MinWeight": 11, "MaxWeight": 15 } },

    // 16 ~ 20 磅：中型武器（标准步枪、霰弹枪等）
    { "Priority": 48, "Value": 5, "Conditions": { "MinWeight": 16, "MaxWeight": 20 } },

    // 21 ~ 25 磅：中重型武器（突击步枪、战斗霰弹枪等）
