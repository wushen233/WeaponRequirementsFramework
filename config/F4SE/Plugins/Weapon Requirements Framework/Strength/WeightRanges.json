    // 46 ~ 50 磅：超级武器
    { "Priority": 42, "Value": 11, "Conditions": { "MinWeight": 46, "MaxWeight": 50 } },

    // 51 磅以上：终极封顶
    { "Priority": 41, "Value": 12, "Conditions": { "MinWeight": 51 } }
  ]
